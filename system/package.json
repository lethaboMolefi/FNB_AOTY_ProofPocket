{
  "name": "proofpocket",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @proofpocket/web test:e2e",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @proofpocket/api db:migrate",
    "db:reset": "pnpm --filter @proofpocket/api db:reset",
    "db:generate": "pnpm --filter @proofpocket/api db:generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
