{
  "name": "@proofpocket/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:reset": "tsx --env-file=.env src/db/seed/reset.ts",
    "openapi": "tsx src/openapi-print.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@proofpocket/shared": "workspace:*",
    "cors": "2.8.5",
    "drizzle-orm": "0.36.4",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "firebase-admin": "13.0.1",
    "helmet": "8.0.0",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.28.1",
    "esbuild": "0.24.0",
    "pino-pretty": "13.0.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "vitest": "2.1.8"
  }
}
