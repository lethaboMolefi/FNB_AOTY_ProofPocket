  USERS {
    uuid id PK
    enum role
    text email
    uuid org_id FK
    text firebase_uid
    boolean must_change_password
    timestamptz temp_password_expires_at
    timestamptz suspended_at
    text suspended_reason
    timestamptz last_seen_at
  }
  FOUNDER_IDENTITY {
    uuid company_id PK,FK
    text id_number_enc "AES-256-GCM"
    text phone
  }
  COMPANY_COFOUNDERS {
    uuid id PK
    uuid company_id FK
    text full_name
    text id_number_enc "AES-256-GCM"
    smallint shareholding
  }
  PORTAL_APPLICATIONS {
    uuid id PK
    enum kind "funder or support_org"
    enum status "pending, approved, rejected"
    text firebase_uid
    text email
    text org_name
    text contact_id_number_enc "AES-256-GCM"
    jsonb details
    text review_reason
    uuid user_id FK
    uuid org_id FK
  }
  SENDER_WATCHLIST {
    text sender_key PK
    smallint reports
    enum status
  }
  LOCAL_CREDENTIALS {
    uuid id PK
    text email "development sign-in only"
    text password_hash "scrypt"
  }
  RATE_LIMIT_HITS {
    text key PK
    integer hits
    timestamptz reset_at
  }
  COMPANIES {
    uuid id PK
    uuid owner_id FK
    text name
    enum business_type
    enum funder_sharing
    timestamptz verified_at
    smallint support_stage
    text consent_version
  }
  DOCUMENTS {
    uuid id PK
    uuid company_id FK
    enum doc_type
    int version
    enum status
    uuid file_id FK
  }
  FILES {
    uuid id PK
    uuid company_id FK
    enum purpose
    text bucket_path
    text sha256
  }
  LEDGER_ENTRIES {
    uuid id PK
    uuid company_id FK
    uuid client_uuid UK
    date entry_date
    enum direction
    numeric amount
    bool is_personal
    timestamptz voided_at
  }
  PAYMENT_REQUESTS {
    uuid id PK
    uuid company_id FK
    text ref UK
    text public_token
    numeric amount
    enum status
    smallint attempts
  }
  PAYMENT_PROOFS {
    uuid id PK
    uuid payment_request_id FK
    uuid file_id FK
    jsonb check_results
    enum status
  }
  PAYMENT_DETAILS {
    uuid id PK
    uuid company_id FK
    text account_number_enc
    text account_last4
  }
  APPLICATIONS {
    uuid id PK
    uuid company_id FK
    uuid programme_id FK
    uuid funder_id FK
    enum status
  }
  OFFERS {
    uuid id PK
    uuid application_id FK
    numeric amount
    text reason
  }
  AUDIT_LOG {
    bigint id PK
    bigint chain_seq UK
    text action
    jsonb before
    jsonb after
    text prev_hash
    text hash
  }
