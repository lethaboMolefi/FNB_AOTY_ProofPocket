# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8787
# The API connects as the restricted app role so row-level security applies.
DATABASE_URL=postgres://proofpocket_app:app_dev_password@localhost:5433/proofpocket
# Migrations and the dev seed run as the owner. Not used by the running API.
DATABASE_OWNER_URL=postgres://proofpocket_owner:owner_dev_password@localhost:5433/proofpocket
WEB_ORIGIN=http://localhost:5173

# firebase = verify Firebase ID tokens (production). local = email + password checked by the API (development only).
AUTH_MODE=local
FIREBASE_PROJECT_ID=

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCOUNT_NUMBER_KEY=
OTP_SECRET=

# console = print emails (and PINs) to the API log. smtp = send through Gmail.
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# A Gmail app password (Google account > Security > App passwords), not your normal password.
SMTP_PASS=
MAIL_FROM="ProofPocket <you@gmail.com>"

# Dev seed: the admin (ProofPocket checker) account's email.
SEED_ADMIN_EMAIL=admin@proofpocket.example
